{
  "apiVersion": "enterprise-risk/feature-definition/v2",
  "kind": "FeatureDefinition",
  "metadata": {
    "id": "a01_identity_verification_gap",
    "version": "1.0.0",
    "name": "来源参与方身份解析缺口"
  },
  "coverage": [
    {
      "sourceId": "ubo_mvp_standardized",
      "granularity": "DAY",
      "requiredThrough": "evaluationDate",
      "lookbackPeriods": 1
    }
  ],
  "spec": {
    "kind": "typedPlan",
    "operators": [
      {
        "id": "scan_shareholder_source_record",
        "op": "ScanClass",
        "class": "urn:hovo:ecp:a01-ubo:ontology:ShareholderSourceRecord",
        "bind": "sourceRecord"
      },
      {
        "id": "project_identity_gap",
        "op": "ProjectAssertions",
        "input": "scan_shareholder_source_record",
        "subject": {
          "template": "urn:hovo:ecp:a01-ubo:derived:identity-gap:{sourceRecordId}",
          "fields": {
            "sourceRecordId": {
              "op": "CompactId",
              "value": { "op": "Var", "name": "sourceRecord" }
            }
          }
        },
        "assertions": [
          {
            "predicate": "urn:hovo:ecp:a01-ubo:ontology:identityGapReason",
            "object": { "op": "String", "value": "SOURCE_PARTICIPANT_IDENTITY_NOT_RESOLVED" },
            "objectKind": "string",
            "cardinality": "one"
          },
          {
            "predicate": "urn:hovo:ecp:a01-ubo:ontology:gapForSourceObservation",
            "object": { "op": "Var", "name": "sourceRecord" },
            "objectKind": "iri",
            "cardinality": "one"
          }
        ]
      }
    ]
  },
  "tests": { "contract": "a01-source-identity-resolution-gap-contract-v1" }
}

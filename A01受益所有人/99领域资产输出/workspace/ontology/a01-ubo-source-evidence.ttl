@prefix a01: <urn:hovo:ecp:a01-ubo:ontology:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

a01:sourceEvidenceOntology a owl:Ontology ;
    owl:versionIRI <urn:hovo:ecp:a01-ubo:ontology:version:1.0.0> ;
    owl:versionInfo "1.0.0" ;
    rdfs:label "A01受益所有人来源证据本体"@zh-CN ;
    rdfs:comment "用于投影标准化来源记录和承载受益所有人识别所需业务概念。来源观察不等同于经核实主体、权利状态或已识别受益所有人。"@zh-CN .

a01:Subject a owl:Class ; rdfs:label "主体"@zh-CN ; rdfs:comment "能够作为权利持有人或核实对象的现实世界主体。"@zh-CN .
a01:Organization a owl:Class ; rdfs:subClassOf a01:Subject ; rdfs:label "组织"@zh-CN ; rdfs:comment "现实世界中的组织。当前来源快照没有可用于映射其业务身份的完整核实条件。"@zh-CN .
a01:NaturalPerson a owl:Class ; rdfs:subClassOf a01:Subject ; rdfs:label "自然人"@zh-CN ; rdfs:comment "现实世界中的自然人。姓名不是唯一身份，当前来源快照不映射其业务身份实例。"@zh-CN .
a01:RightsPosition a owl:Class ; rdfs:label "权利位置"@zh-CN ; rdfs:comment "某主体相对目标组织实际拥有、收益、表决或控制的权利位置；来源主张保留为SourceObservation，当前不映射权利位置实例。"@zh-CN .
a01:RightsState a owl:Class ; rdfs:label "权利状态"@zh-CN ; rdfs:comment "权利位置在一个业务有效区间内的带版本状态记录。生效与终止依据、获知时间分别保存；现实状态与机构何时获知并非同一时间。当前未映射。"@zh-CN .
a01:IdentificationRecord a owl:Class ; rdfs:label "识别记录"@zh-CN ; rdfs:comment "对识别任务、适用口径、候选和未知项的业务记录；当前未映射。"@zh-CN .
a01:VerificationRecord a owl:Class ; rdfs:label "核实记录"@zh-CN ; rdfs:comment "人员或机构对证据、身份或权利状态进行核实的记录；当前未映射。"@zh-CN .
a01:EvidenceMaterial a owl:Class ; rdfs:label "证据材料"@zh-CN ; rdfs:comment "用于支持或反驳业务主张的材料；当前来源只含摘要或文本，未形成材料采信实例。"@zh-CN .
a01:Discrepancy a owl:Class ; rdfs:label "差异"@zh-CN ; rdfs:comment "不同来源、申报或核实结果之间待解释的差异；当前未映射。"@zh-CN .
a01:FollowUpAction a owl:Class ; rdfs:label "后续处理"@zh-CN ; rdfs:comment "经授权人员决定的补证、复核或更新处理；当前未映射且不代表外部执行动作。"@zh-CN .

a01:SourceObservation a owl:Class ; rdfs:label "来源观察"@zh-CN ; rdfs:comment "从标准化数据表读取的来源记录。它保留来源口径，不能推定真实主体、权利、控制或正式业务结论。"@zh-CN .
a01:CompanySourceRecord a owl:Class ; rdfs:subClassOf a01:SourceObservation ; rdfs:label "企业来源记录"@zh-CN .
a01:ShareholderSourceRecord a owl:Class ; rdfs:subClassOf a01:SourceObservation ; rdfs:label "股东来源记录"@zh-CN .
a01:PenetrationObservation a owl:Class ; rdfs:subClassOf a01:SourceObservation ; rdfs:label "股权穿透来源观察"@zh-CN ; rdfs:comment "来源报告的穿透链路观察；比例与终端标记不构成受益所有人认定。"@zh-CN .
a01:ControllerPathEdgeObservation a owl:Class ; rdfs:subClassOf a01:SourceObservation ; rdfs:label "控制路径边来源观察"@zh-CN ; rdfs:comment "外部报告的实际控制人路径边线索，不是平台最终认定。"@zh-CN .
a01:ExecutiveAppointmentObservation a owl:Class ; rdfs:subClassOf a01:SourceObservation ; rdfs:label "高管任职来源观察"@zh-CN .
a01:CompanyChangeObservation a owl:Class ; rdfs:subClassOf a01:SourceObservation ; rdfs:label "企业变更来源观察"@zh-CN ; rdfs:comment "来源登记的企业变更；变更日期不自动等同于权利关系生效日期。"@zh-CN .
a01:SourceLineageRecord a owl:Class ; rdfs:subClassOf a01:SourceObservation ; rdfs:label "来源追踪记录"@zh-CN ; rdfs:comment "ETL来源记录。standard_table与standard_id是多态定位信息，当前不建立跨表对象关系。issues_json无受支持JSON字面量或转换，保留在Schema快照中且不投影为运行时断言。"@zh-CN .
a01:IdentityVerificationGap a owl:Class ; rdfs:label "来源身份解析缺口"@zh-CN ; rdfs:comment "来源股东名称缺少可验证身份标识时形成的派生缺口；不表示该来源参与方已被识别为自然人。"@zh-CN .
a01:RightsTimeVerificationGap a owl:Class ; rdfs:label "权利时间证据缺口"@zh-CN ; rdfs:comment "来源股东记录未提供权利生效证据时形成的派生缺口；不表示已存在一项经确认权利。"@zh-CN .

a01:rightsPositionForOrganization a owl:ObjectProperty ; rdfs:domain a01:RightsPosition ; rdfs:range a01:Organization ; rdfs:label "权利位置针对组织"@zh-CN .
a01:heldBy a owl:ObjectProperty ; rdfs:domain a01:RightsPosition ; rdfs:range a01:Subject ; rdfs:label "由主体持有"@zh-CN .
a01:hasRightsState a owl:ObjectProperty ; rdfs:domain a01:RightsPosition ; rdfs:range a01:RightsState ; rdfs:label "具有权利状态"@zh-CN .
a01:stateSupportedBy a owl:ObjectProperty ; rdfs:domain a01:RightsState ; rdfs:range a01:EvidenceMaterial ; rdfs:label "状态由材料支持"@zh-CN .
a01:describesRightsPosition a owl:ObjectProperty ; rdfs:domain a01:SourceObservation ; rdfs:range a01:RightsPosition ; rdfs:label "来源主张涉及权利位置"@zh-CN ; rdfs:comment "仅在有身份及位置关联依据时建立，不表示该来源主张已采信；当前Mapping不产生此关系。"@zh-CN .
a01:supportedBy a owl:ObjectProperty ; rdfs:domain a01:RightsPosition ; rdfs:range a01:EvidenceMaterial ; rdfs:label "由材料支持"@zh-CN .
a01:verifiedIn a owl:ObjectProperty ; rdfs:domain a01:RightsPosition ; rdfs:range a01:VerificationRecord ; rdfs:label "在核实记录中核实"@zh-CN .
a01:identificationForOrganization a owl:ObjectProperty ; rdfs:domain a01:IdentificationRecord ; rdfs:range a01:Organization ; rdfs:label "识别记录针对组织"@zh-CN .
a01:identifiedNaturalPerson a owl:ObjectProperty ; rdfs:domain a01:IdentificationRecord ; rdfs:range a01:NaturalPerson ; rdfs:label "识别记录中的自然人"@zh-CN .
a01:considersRightsState a owl:ObjectProperty ; rdfs:domain a01:IdentificationRecord ; rdfs:range a01:RightsState ; rdfs:label "识别采用的权利状态"@zh-CN .
a01:basedOnVerification a owl:ObjectProperty ; rdfs:domain a01:IdentificationRecord ; rdfs:range a01:VerificationRecord ; rdfs:label "识别依据核实记录"@zh-CN .
a01:verifiesSubject a owl:ObjectProperty ; rdfs:domain a01:VerificationRecord ; rdfs:range a01:Subject ; rdfs:label "核实对象"@zh-CN .
a01:usesEvidenceMaterial a owl:ObjectProperty ; rdfs:domain a01:VerificationRecord ; rdfs:range a01:EvidenceMaterial ; rdfs:label "使用证据材料"@zh-CN .
a01:hasDiscrepancy a owl:ObjectProperty ; rdfs:domain a01:IdentificationRecord ; rdfs:range a01:Discrepancy ; rdfs:label "存在差异"@zh-CN .
a01:requiresFollowUp a owl:ObjectProperty ; rdfs:domain a01:Discrepancy ; rdfs:range a01:FollowUpAction ; rdfs:label "需要后续处理"@zh-CN .
a01:changeForCompanySourceRecord a owl:ObjectProperty ; rdfs:domain a01:CompanyChangeObservation ; rdfs:range a01:CompanySourceRecord ; rdfs:label "对应企业来源记录"@zh-CN .
a01:controllerEdgeForCompanySourceRecord a owl:ObjectProperty ; rdfs:domain a01:ControllerPathEdgeObservation ; rdfs:range a01:CompanySourceRecord ; rdfs:label "针对企业来源记录"@zh-CN .
a01:executiveForCompanySourceRecord a owl:ObjectProperty ; rdfs:domain a01:ExecutiveAppointmentObservation ; rdfs:range a01:CompanySourceRecord ; rdfs:label "任职于企业来源记录"@zh-CN .
a01:shareholderOfCompanySourceRecord a owl:ObjectProperty ; rdfs:domain a01:ShareholderSourceRecord ; rdfs:range a01:CompanySourceRecord ; rdfs:label "股东记录对应被投资企业来源记录"@zh-CN .
a01:ownerCompanySourceRecord a owl:ObjectProperty ; rdfs:domain a01:ShareholderSourceRecord ; rdfs:range a01:CompanySourceRecord ; rdfs:label "来源匹配的企业股东记录"@zh-CN .
a01:penetrationRootCompanySourceRecord a owl:ObjectProperty ; rdfs:domain a01:PenetrationObservation ; rdfs:range a01:CompanySourceRecord ; rdfs:label "穿透根企业来源记录"@zh-CN .
a01:penetrationTargetCompanySourceRecord a owl:ObjectProperty ; rdfs:domain a01:PenetrationObservation ; rdfs:range a01:CompanySourceRecord ; rdfs:label "穿透目标企业来源记录"@zh-CN .
a01:penetrationOwnerCompanySourceRecord a owl:ObjectProperty ; rdfs:domain a01:PenetrationObservation ; rdfs:range a01:CompanySourceRecord ; rdfs:label "穿透来源匹配的企业股东记录"@zh-CN .
a01:penetrationShareholderSourceRecord a owl:ObjectProperty ; rdfs:domain a01:PenetrationObservation ; rdfs:range a01:ShareholderSourceRecord ; rdfs:label "穿透来源关联的股东记录"@zh-CN .
a01:gapForSourceObservation a owl:ObjectProperty ; rdfs:domain a01:IdentityVerificationGap ; rdfs:range a01:SourceObservation ; rdfs:label "针对来源观察的身份缺口"@zh-CN .
a01:timeGapForSourceObservation a owl:ObjectProperty ; rdfs:domain a01:RightsTimeVerificationGap ; rdfs:range a01:SourceObservation ; rdfs:label "针对来源观察的时间缺口"@zh-CN .

a01:firstQualifiedOn a owl:DatatypeProperty ; rdfs:domain a01:IdentificationRecord ; rdfs:range xsd:date ; rdfs:label "首次满足适用识别条件日期"@zh-CN ; rdfs:comment "取决于人员、客户、适用制度和识别条件；不能视为某个比例状态的固有属性。"@zh-CN .
a01:currentStateEffectiveOn a owl:DatatypeProperty ; rdfs:domain a01:RightsState ; rdfs:range xsd:date ; rdfs:label "当前状态生效日期"@zh-CN .
a01:endedOn a owl:DatatypeProperty ; rdfs:domain a01:RightsState ; rdfs:range xsd:date ; rdfs:label "权利状态终止日期"@zh-CN .
a01:verifiedOn a owl:DatatypeProperty ; rdfs:domain a01:VerificationRecord ; rdfs:range xsd:date ; rdfs:label "核实日期"@zh-CN .
a01:filingOn a owl:DatatypeProperty ; rdfs:domain a01:IdentificationRecord ; rdfs:range xsd:date ; rdfs:label "备案或更新日期"@zh-CN .
a01:rightType a owl:DatatypeProperty ; rdfs:domain a01:RightsPosition ; rdfs:range xsd:string ; rdfs:label "权利类型"@zh-CN .
a01:rightsContent a owl:DatatypeProperty ; rdfs:domain a01:RightsState ; rdfs:range xsd:string ; rdfs:label "权利内容"@zh-CN .
a01:rightsRatio a owl:DatatypeProperty ; rdfs:domain a01:RightsState ; rdfs:range xsd:decimal ; rdfs:label "权利比例"@zh-CN .
a01:shareClass a owl:DatatypeProperty ; rdfs:domain a01:RightsPosition ; rdfs:range xsd:string ; rdfs:label "权益类别"@zh-CN .
a01:denominatorBasis a owl:DatatypeProperty ; rdfs:domain a01:RightsPosition ; rdfs:range xsd:string ; rdfs:label "权利比例分母口径"@zh-CN .
a01:ratioUnit a owl:DatatypeProperty ; rdfs:domain a01:RightsState ; rdfs:range xsd:string ; rdfs:label "权利比例单位"@zh-CN ; rdfs:comment "本次设计使用PERCENT，0至100百分点；其他单位不得隐式混用。"@zh-CN .
a01:validFrom a owl:DatatypeProperty ; rdfs:domain a01:RightsState ; rdfs:range xsd:date ; rdfs:label "业务有效期起始日期"@zh-CN .
a01:validThrough a owl:DatatypeProperty ; rdfs:domain a01:RightsState ; rdfs:range xsd:date ; rdfs:label "业务有效期终点"@zh-CN ; rdfs:comment "设计采用左闭右开区间，终点当日不纳入；源日期须先确认生效口径。缺值不能推断长期有效。"@zh-CN .
a01:knowledgeCutoff a owl:DatatypeProperty ; rdfs:domain a01:IdentificationRecord ; rdfs:range xsd:dateTime ; rdfs:label "识别所用知识截止时刻"@zh-CN .
a01:knownAt a owl:DatatypeProperty ; rdfs:domain a01:RightsState ; rdfs:range xsd:dateTime ; rdfs:label "已知时间"@zh-CN .
a01:formationDateStatus a owl:DatatypeProperty ; rdfs:domain a01:RightsState ; rdfs:range xsd:string ; rdfs:label "形成日期证据状态"@zh-CN ; rdfs:comment "区分精确日、已知范围与未知；缺值不作精确日使用。当前无映射数据。"@zh-CN .
a01:formationEarliestOn a owl:DatatypeProperty ; rdfs:domain a01:RightsState ; rdfs:range xsd:date ; rdfs:label "有证据的最早可能形成日"@zh-CN .
a01:formationLatestOn a owl:DatatypeProperty ; rdfs:domain a01:RightsState ; rdfs:range xsd:date ; rdfs:label "有证据的最晚可能形成日"@zh-CN .
a01:endStatus a owl:DatatypeProperty ; rdfs:domain a01:RightsState ; rdfs:range xsd:string ; rdfs:label "终止证据状态"@zh-CN ; rdfs:comment "区分已知终止、明确持续与未知；接口长期有效哨兵不作为现实终止日。"@zh-CN .
a01:policyVersion a owl:DatatypeProperty ; rdfs:domain a01:IdentificationRecord ; rdfs:range xsd:string ; rdfs:label "适用政策版本"@zh-CN .
a01:businessAsOf a owl:DatatypeProperty ; rdfs:domain a01:IdentificationRecord ; rdfs:range xsd:date ; rdfs:label "业务时点"@zh-CN .
a01:identificationStatus a owl:DatatypeProperty ; rdfs:domain a01:IdentificationRecord ; rdfs:range xsd:string ; rdfs:label "识别状态"@zh-CN .
a01:recordOrigin a owl:DatatypeProperty ; rdfs:domain a01:IdentificationRecord ; rdfs:range xsd:string ; rdfs:label "识别记录来源及用途"@zh-CN ; rdfs:comment "区分客户申报、备案查询、机构拟识别和机构正式记录，不能相互覆盖。"@zh-CN .
a01:evidenceLocator a owl:DatatypeProperty ; rdfs:domain a01:EvidenceMaterial ; rdfs:range xsd:string ; rdfs:label "材料定位"@zh-CN .
a01:evidenceDigest a owl:DatatypeProperty ; rdfs:domain a01:EvidenceMaterial ; rdfs:range xsd:string ; rdfs:label "材料原字节摘要"@zh-CN .
a01:verificationResult a owl:DatatypeProperty ; rdfs:domain a01:VerificationRecord ; rdfs:range xsd:string ; rdfs:label "核实结论及理由"@zh-CN .
a01:verifiedBy a owl:DatatypeProperty ; rdfs:domain a01:VerificationRecord ; rdfs:range xsd:string ; rdfs:label "核实责任人标识"@zh-CN .
a01:identityGapReason a owl:DatatypeProperty ; rdfs:domain a01:IdentityVerificationGap ; rdfs:range xsd:string ; rdfs:label "身份解析缺口原因"@zh-CN .
a01:rightsTimeGapReason a owl:DatatypeProperty ; rdfs:domain a01:RightsTimeVerificationGap ; rdfs:range xsd:string ; rdfs:label "权利时间证据缺口原因"@zh-CN .

a01:sourceRecordId a owl:DatatypeProperty ; rdfs:domain a01:SourceObservation ; rdfs:range xsd:integer ; rdfs:label "来源记录标识"@zh-CN .
a01:companyName a owl:DatatypeProperty ; rdfs:domain a01:CompanySourceRecord ; rdfs:range xsd:string ; rdfs:label "企业名称来源文本"@zh-CN .
a01:unifiedSocialCreditCode a owl:DatatypeProperty ; rdfs:domain a01:CompanySourceRecord ; rdfs:range xsd:string ; rdfs:label "统一社会信用代码来源文本"@zh-CN .
a01:registrationStatus a owl:DatatypeProperty ; rdfs:domain a01:CompanySourceRecord ; rdfs:range xsd:string ; rdfs:label "登记状态来源文本"@zh-CN .
a01:legalRepresentativeName a owl:DatatypeProperty ; rdfs:domain a01:CompanySourceRecord ; rdfs:range xsd:string ; rdfs:label "法定代表人姓名来源文本"@zh-CN .
a01:enterpriseType a owl:DatatypeProperty ; rdfs:domain a01:CompanySourceRecord ; rdfs:range xsd:string ; rdfs:label "企业类型来源文本"@zh-CN .
a01:establishmentDate a owl:DatatypeProperty ; rdfs:domain a01:CompanySourceRecord ; rdfs:range xsd:date ; rdfs:label "企业成立日期来源值"@zh-CN .
a01:changeDate a owl:DatatypeProperty ; rdfs:domain a01:CompanyChangeObservation ; rdfs:range xsd:date ; rdfs:label "企业变更日期来源值"@zh-CN .
a01:changeItem a owl:DatatypeProperty ; rdfs:domain a01:CompanyChangeObservation ; rdfs:range xsd:string ; rdfs:label "变更事项来源文本"@zh-CN .
a01:contentBeforeDigest a owl:DatatypeProperty ; rdfs:domain a01:CompanyChangeObservation ; rdfs:range xsd:string ; rdfs:label "变更前内容摘要"@zh-CN .
a01:contentAfterDigest a owl:DatatypeProperty ; rdfs:domain a01:CompanyChangeObservation ; rdfs:range xsd:string ; rdfs:label "变更后内容摘要"@zh-CN .
a01:changeDataSource a owl:DatatypeProperty ; rdfs:domain a01:CompanyChangeObservation ; rdfs:range xsd:string ; rdfs:label "变更数据来源文本"@zh-CN .
a01:contentBefore a owl:DatatypeProperty ; rdfs:domain a01:CompanyChangeObservation ; rdfs:range xsd:string ; rdfs:label "变更前原文"@zh-CN .
a01:contentAfter a owl:DatatypeProperty ; rdfs:domain a01:CompanyChangeObservation ; rdfs:range xsd:string ; rdfs:label "变更后原文"@zh-CN .
a01:reportedActualControllerId a owl:DatatypeProperty ; rdfs:domain a01:ControllerPathEdgeObservation ; rdfs:range xsd:string ; rdfs:label "来源报告实际控制主体标识"@zh-CN .
a01:reportedActualControllerName a owl:DatatypeProperty ; rdfs:domain a01:ControllerPathEdgeObservation ; rdfs:range xsd:string ; rdfs:label "来源报告实际控制主体名称"@zh-CN .
a01:reportedPersonalFlag a owl:DatatypeProperty ; rdfs:domain a01:ControllerPathEdgeObservation ; rdfs:range xsd:integer ; rdfs:label "来源报告自然人标记"@zh-CN .
a01:reportedVotePercentText a owl:DatatypeProperty ; rdfs:domain a01:ControllerPathEdgeObservation ; rdfs:range xsd:string ; rdfs:label "来源报告表决权比例文本"@zh-CN .
a01:reportedBeneficiaProportionText a owl:DatatypeProperty ; rdfs:domain a01:ControllerPathEdgeObservation ; rdfs:range xsd:string ; rdfs:label "来源报告受益比例文本"@zh-CN .
a01:pathSequence a owl:DatatypeProperty ; rdfs:domain a01:ControllerPathEdgeObservation ; rdfs:range xsd:integer ; rdfs:label "来源路径序号"@zh-CN .
a01:edgeSequence a owl:DatatypeProperty ; rdfs:domain a01:ControllerPathEdgeObservation ; rdfs:range xsd:integer ; rdfs:label "来源路径边序号"@zh-CN .
a01:startName a owl:DatatypeProperty ; rdfs:domain a01:ControllerPathEdgeObservation ; rdfs:range xsd:string ; rdfs:label "路径起点名称"@zh-CN .
a01:startNodeId a owl:DatatypeProperty ; rdfs:domain a01:ControllerPathEdgeObservation ; rdfs:range xsd:string ; rdfs:label "路径起点节点标识"@zh-CN .
a01:startNodeType a owl:DatatypeProperty ; rdfs:domain a01:ControllerPathEdgeObservation ; rdfs:range xsd:string ; rdfs:label "路径起点节点类型"@zh-CN .
a01:endName a owl:DatatypeProperty ; rdfs:domain a01:ControllerPathEdgeObservation ; rdfs:range xsd:string ; rdfs:label "路径终点名称"@zh-CN .
a01:endNodeId a owl:DatatypeProperty ; rdfs:domain a01:ControllerPathEdgeObservation ; rdfs:range xsd:string ; rdfs:label "路径终点节点标识"@zh-CN .
a01:endNodeType a owl:DatatypeProperty ; rdfs:domain a01:ControllerPathEdgeObservation ; rdfs:range xsd:string ; rdfs:label "路径终点节点类型"@zh-CN .
a01:edgeType a owl:DatatypeProperty ; rdfs:domain a01:ControllerPathEdgeObservation ; rdfs:range xsd:string ; rdfs:label "来源边类型"@zh-CN .
a01:reportedProportionText a owl:DatatypeProperty ; rdfs:domain a01:ControllerPathEdgeObservation ; rdfs:range xsd:string ; rdfs:label "来源路径比例文本"@zh-CN .
a01:reportedProportionValue a owl:DatatypeProperty ; rdfs:domain a01:ControllerPathEdgeObservation ; rdfs:range xsd:decimal ; rdfs:label "来源路径比例数值"@zh-CN .
a01:ratioQuality a owl:DatatypeProperty ; rdfs:domain a01:SourceObservation ; rdfs:range xsd:string ; rdfs:label "来源比例质量"@zh-CN .
a01:personName a owl:DatatypeProperty ; rdfs:domain a01:ExecutiveAppointmentObservation ; rdfs:range xsd:string ; rdfs:label "人员姓名来源文本"@zh-CN .
a01:gender a owl:DatatypeProperty ; rdfs:domain a01:ExecutiveAppointmentObservation ; rdfs:range xsd:string ; rdfs:label "性别来源文本"@zh-CN .
a01:position a owl:DatatypeProperty ; rdfs:domain a01:ExecutiveAppointmentObservation ; rdfs:range xsd:string ; rdfs:label "职务来源文本"@zh-CN .
a01:shareholderName a owl:DatatypeProperty ; rdfs:domain a01:PenetrationObservation ; rdfs:range xsd:string ; rdfs:label "穿透股东名称来源文本"@zh-CN .
a01:shareholdingRatio a owl:DatatypeProperty ; rdfs:domain a01:PenetrationObservation ; rdfs:range xsd:decimal ; rdfs:label "当前目标企业链路持股比例"@zh-CN .
a01:penetrationLevel a owl:DatatypeProperty ; rdfs:domain a01:PenetrationObservation ; rdfs:range xsd:integer ; rdfs:label "来源穿透层级"@zh-CN .
a01:reportedTerminalFlag a owl:DatatypeProperty ; rdfs:domain a01:PenetrationObservation ; rdfs:range xsd:integer ; rdfs:label "来源终端节点标记"@zh-CN .

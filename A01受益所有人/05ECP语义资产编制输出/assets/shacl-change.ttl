@prefix u: <urn:hovo:a01:ubo:v1:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

u:ChangeObservationShape a sh:NodeShape ;
  sh:targetClass u:ChangeObservation ;
  sh:property [ sh:path u:changeDate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
  sh:property [ sh:path u:subject ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

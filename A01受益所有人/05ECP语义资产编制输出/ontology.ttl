@prefix a01: <urn:ecp:a01:ubo:v1:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:ecp:a01:ubo:v1:ontology> a owl:Ontology ; rdfs:label "A01 受益所有人 ECP V3 本体"@zh .

<urn:ecp:a01:ubo:v1:NaturalPerson> a owl:Class ; rdfs:label "自然人"@zh ; rdfs:comment "能够以个人身份承担权益、控制或业务角色，并且只有自然人才可能成为最终受益所有人。"@zh .
<urn:ecp:a01:ubo:v1:NaturalPerson_full_name> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:NaturalPerson> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "姓名"@zh .
<urn:ecp:a01:ubo:v1:NaturalPerson_gender> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:NaturalPerson> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "性别"@zh .
<urn:ecp:a01:ubo:v1:NaturalPerson_nationality> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:NaturalPerson> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "国籍"@zh .
<urn:ecp:a01:ubo:v1:NaturalPerson_birth_date> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:NaturalPerson> ; rdfs:range <http://www.w3.org/2001/XMLSchema#date> ; rdfs:label "出生日期"@zh .
<urn:ecp:a01:ubo:v1:NaturalPerson_identity_document_type> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:NaturalPerson> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "身份证明类别"@zh .
<urn:ecp:a01:ubo:v1:NaturalPerson_identity_document_number> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:NaturalPerson> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "身份证明号码"@zh .
<urn:ecp:a01:ubo:v1:NaturalPerson_issuing_jurisdiction> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:NaturalPerson> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "证件签发国家或地区"@zh .
<urn:ecp:a01:ubo:v1:NaturalPerson_identity_document_expiry> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:NaturalPerson> ; rdfs:range <http://www.w3.org/2001/XMLSchema#date> ; rdfs:label "证件有效期限"@zh .

<urn:ecp:a01:ubo:v1:Organization> a owl:Class ; rdfs:label "组织主体"@zh ; rdfs:comment "公司、合伙企业、社会组织等具有独立组织身份、可承载权益和治理关系的非自然人主体。"@zh .
<urn:ecp:a01:ubo:v1:Organization_registered_name> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Organization> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "登记名称"@zh .
<urn:ecp:a01:ubo:v1:Organization_registration_identifier> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Organization> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "登记识别号"@zh .
<urn:ecp:a01:ubo:v1:Organization_registration_jurisdiction> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Organization> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "登记法域"@zh .
<urn:ecp:a01:ubo:v1:Organization_legal_form> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Organization> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "组织形态"@zh .
<urn:ecp:a01:ubo:v1:Organization_established_on> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Organization> ; rdfs:range <http://www.w3.org/2001/XMLSchema#date> ; rdfs:label "设立日期"@zh .

<urn:ecp:a01:ubo:v1:Branch> a owl:Class ; rdfs:label "分支机构"@zh ; rdfs:comment "依附于所属组织、但在特定规则下具有独立识别语义的境内分支或外国公司中国分支。"@zh .
<urn:ecp:a01:ubo:v1:Branch_registered_name> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Branch> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "分支登记名称"@zh .
<urn:ecp:a01:ubo:v1:Branch_registration_identifier> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Branch> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "分支登记识别号"@zh .
<urn:ecp:a01:ubo:v1:Branch_registration_jurisdiction> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Branch> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "登记法域"@zh .
<urn:ecp:a01:ubo:v1:Branch_branch_kind> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Branch> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "分支类型"@zh .
<urn:ecp:a01:ubo:v1:Branch_established_on> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Branch> ; rdfs:range <http://www.w3.org/2001/XMLSchema#date> ; rdfs:label "设立日期"@zh .

<urn:ecp:a01:ubo:v1:Trust> a owl:Class ; rdfs:label "信托"@zh ; rdfs:comment "由委托人、受托人、受益人、监察人及其他最终控制权安排共同构成的信托关系对象。"@zh .
<urn:ecp:a01:ubo:v1:Trust_trust_name_or_reference> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Trust> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "信托名称或编号"@zh .
<urn:ecp:a01:ubo:v1:Trust_governing_jurisdiction> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Trust> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "适用法域"@zh .
<urn:ecp:a01:ubo:v1:Trust_trust_type> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Trust> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "信托类别"@zh .
<urn:ecp:a01:ubo:v1:Trust_established_on> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Trust> ; rdfs:range <http://www.w3.org/2001/XMLSchema#date> ; rdfs:label "设立日期"@zh .

<urn:ecp:a01:ubo:v1:AssetProduct> a owl:Class ; rdfs:label "资产管理产品"@zh ; rdfs:comment "需要根据产品权利结构、管理受托关系、募集备案和风险判断受益所有人的资产管理产品。"@zh .
<urn:ecp:a01:ubo:v1:AssetProduct_product_name_or_code> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:AssetProduct> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "产品名称或代码"@zh .
<urn:ecp:a01:ubo:v1:AssetProduct_product_category> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:AssetProduct> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "产品类别"@zh .
<urn:ecp:a01:ubo:v1:AssetProduct_offering_type> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:AssetProduct> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "募集方式"@zh .
<urn:ecp:a01:ubo:v1:AssetProduct_registration_status> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:AssetProduct> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "备案登记状态"@zh .

<urn:ecp:a01:ubo:v1:Evidence> a owl:Class ; rdfs:label "识别证据"@zh ; rdfs:comment "用于支持或质疑自然人身份、业务关系、角色、有效期间或业务判断的可追溯来源材料。"@zh .
<urn:ecp:a01:ubo:v1:Evidence_source_identifier> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Evidence> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "来源标识"@zh .
<urn:ecp:a01:ubo:v1:Evidence_locator> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Evidence> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "材料位置"@zh .
<urn:ecp:a01:ubo:v1:Evidence_source_type> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Evidence> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "来源类型"@zh .
<urn:ecp:a01:ubo:v1:Evidence_issued_on> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Evidence> ; rdfs:range <http://www.w3.org/2001/XMLSchema#date> ; rdfs:label "材料形成日期"@zh .
<urn:ecp:a01:ubo:v1:Evidence_verified_on> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Evidence> ; rdfs:range <http://www.w3.org/2001/XMLSchema#date> ; rdfs:label "核实日期"@zh .
<urn:ecp:a01:ubo:v1:Evidence_reliability> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Evidence> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "可靠性状态"@zh .
<urn:ecp:a01:ubo:v1:Evidence_claim_summary> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Evidence> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "所支持或质疑的事实"@zh .

<urn:ecp:a01:ubo:v1:IdentificationResult> a owl:Class ; rdfs:label "受益所有人识别结果"@zh ; rdfs:comment "针对一个具体识别对象、责任语境和判断时点形成的受益所有人业务结果，明确已确认自然人及仍未解决的缺口。"@zh .
<urn:ecp:a01:ubo:v1:IdentificationResult_result_reference> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:IdentificationResult> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "结果标识"@zh .
<urn:ecp:a01:ubo:v1:IdentificationResult_purpose> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:IdentificationResult> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "责任语境"@zh .
<urn:ecp:a01:ubo:v1:IdentificationResult_as_of> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:IdentificationResult> ; rdfs:range <http://www.w3.org/2001/XMLSchema#date> ; rdfs:label "判断时点"@zh .
<urn:ecp:a01:ubo:v1:IdentificationResult_completeness> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:IdentificationResult> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "完整性"@zh .

<urn:ecp:a01:ubo:v1:Rel_NaturalPersonEquity> a owl:Class ; rdfs:label "自然人直接权益关系"@zh ; rdfs:comment "自然人在特定期间直接持有组织的股权、股份或合伙权益。"@zh .
<urn:ecp:a01:ubo:v1:Rel_NaturalPersonEquity_holder> a owl:ObjectProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_NaturalPersonEquity> ; rdfs:range <urn:ecp:a01:ubo:v1:NaturalPerson> ; rdfs:label "自然人持有人"@zh .
<urn:ecp:a01:ubo:v1:Rel_NaturalPersonEquity_subject> a owl:ObjectProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_NaturalPersonEquity> ; rdfs:range <urn:ecp:a01:ubo:v1:Organization> ; rdfs:label "权益所及组织"@zh .
<urn:ecp:a01:ubo:v1:Rel_NaturalPersonEquity_interest_type> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_NaturalPersonEquity> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "权益类别"@zh .
<urn:ecp:a01:ubo:v1:Rel_NaturalPersonEquity_percent> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_NaturalPersonEquity> ; rdfs:range <http://www.w3.org/2001/XMLSchema#decimal> ; rdfs:label "本段比例"@zh .
<urn:ecp:a01:ubo:v1:Rel_NaturalPersonEquity_effective_start> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_NaturalPersonEquity> ; rdfs:range <http://www.w3.org/2001/XMLSchema#date> ; rdfs:label "生效日"@zh .
<urn:ecp:a01:ubo:v1:Rel_NaturalPersonEquity_effective_start_bounds> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_NaturalPersonEquity> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "生效时间已知区间"@zh .
<urn:ecp:a01:ubo:v1:Rel_NaturalPersonEquity_effective_end> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_NaturalPersonEquity> ; rdfs:range <http://www.w3.org/2001/XMLSchema#date> ; rdfs:label "终止日"@zh .
<urn:ecp:a01:ubo:v1:Rel_NaturalPersonEquity_effective_end_bounds> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_NaturalPersonEquity> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "终止时间已知区间"@zh .

<urn:ecp:a01:ubo:v1:Rel_OrganizationEquity> a owl:Class ; rdfs:label "组织间权益关系"@zh ; rdfs:comment "一个组织在特定期间直接持有另一个组织的股权、股份或合伙权益。"@zh .
<urn:ecp:a01:ubo:v1:Rel_OrganizationEquity_holder> a owl:ObjectProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_OrganizationEquity> ; rdfs:range <urn:ecp:a01:ubo:v1:Organization> ; rdfs:label "持有人组织"@zh .
<urn:ecp:a01:ubo:v1:Rel_OrganizationEquity_subject> a owl:ObjectProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_OrganizationEquity> ; rdfs:range <urn:ecp:a01:ubo:v1:Organization> ; rdfs:label "被持有组织"@zh .
<urn:ecp:a01:ubo:v1:Rel_OrganizationEquity_interest_type> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_OrganizationEquity> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "权益类别"@zh .
<urn:ecp:a01:ubo:v1:Rel_OrganizationEquity_percent> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_OrganizationEquity> ; rdfs:range <http://www.w3.org/2001/XMLSchema#decimal> ; rdfs:label "本段比例"@zh .
<urn:ecp:a01:ubo:v1:Rel_OrganizationEquity_effective_start> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_OrganizationEquity> ; rdfs:range <http://www.w3.org/2001/XMLSchema#date> ; rdfs:label "生效日"@zh .
<urn:ecp:a01:ubo:v1:Rel_OrganizationEquity_effective_start_bounds> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_OrganizationEquity> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "生效时间已知区间"@zh .
<urn:ecp:a01:ubo:v1:Rel_OrganizationEquity_effective_end> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_OrganizationEquity> ; rdfs:range <http://www.w3.org/2001/XMLSchema#date> ; rdfs:label "终止日"@zh .
<urn:ecp:a01:ubo:v1:Rel_OrganizationEquity_effective_end_bounds> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_OrganizationEquity> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "终止时间已知区间"@zh .

<urn:ecp:a01:ubo:v1:Rel_BenefitRight> a owl:Class ; rdfs:label "最终收益权关系"@zh ; rdfs:comment "自然人在特定期间最终享有组织收益分配权。"@zh .
<urn:ecp:a01:ubo:v1:Rel_BenefitRight_holder> a owl:ObjectProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_BenefitRight> ; rdfs:range <urn:ecp:a01:ubo:v1:NaturalPerson> ; rdfs:label "收益权自然人"@zh .
<urn:ecp:a01:ubo:v1:Rel_BenefitRight_subject> a owl:ObjectProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_BenefitRight> ; rdfs:range <urn:ecp:a01:ubo:v1:Organization> ; rdfs:label "目标组织"@zh .
<urn:ecp:a01:ubo:v1:Rel_BenefitRight_percent> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_BenefitRight> ; rdfs:range <http://www.w3.org/2001/XMLSchema#decimal> ; rdfs:label "最终收益比例"@zh .
<urn:ecp:a01:ubo:v1:Rel_BenefitRight_effective_start> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_BenefitRight> ; rdfs:range <http://www.w3.org/2001/XMLSchema#date> ; rdfs:label "生效日"@zh .
<urn:ecp:a01:ubo:v1:Rel_BenefitRight_effective_start_bounds> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_BenefitRight> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "生效时间已知区间"@zh .
<urn:ecp:a01:ubo:v1:Rel_BenefitRight_effective_end> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_BenefitRight> ; rdfs:range <http://www.w3.org/2001/XMLSchema#date> ; rdfs:label "终止日"@zh .
<urn:ecp:a01:ubo:v1:Rel_BenefitRight_effective_end_bounds> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_BenefitRight> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "终止时间已知区间"@zh .

<urn:ecp:a01:ubo:v1:Rel_VotingRight> a owl:Class ; rdfs:label "最终表决权关系"@zh ; rdfs:comment "自然人在特定期间最终享有组织表决权。"@zh .
<urn:ecp:a01:ubo:v1:Rel_VotingRight_holder> a owl:ObjectProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_VotingRight> ; rdfs:range <urn:ecp:a01:ubo:v1:NaturalPerson> ; rdfs:label "表决权自然人"@zh .
<urn:ecp:a01:ubo:v1:Rel_VotingRight_subject> a owl:ObjectProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_VotingRight> ; rdfs:range <urn:ecp:a01:ubo:v1:Organization> ; rdfs:label "目标组织"@zh .
<urn:ecp:a01:ubo:v1:Rel_VotingRight_percent> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_VotingRight> ; rdfs:range <http://www.w3.org/2001/XMLSchema#decimal> ; rdfs:label "最终表决比例"@zh .
<urn:ecp:a01:ubo:v1:Rel_VotingRight_effective_start> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_VotingRight> ; rdfs:range <http://www.w3.org/2001/XMLSchema#date> ; rdfs:label "生效日"@zh .
<urn:ecp:a01:ubo:v1:Rel_VotingRight_effective_start_bounds> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_VotingRight> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "生效时间已知区间"@zh .
<urn:ecp:a01:ubo:v1:Rel_VotingRight_effective_end> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_VotingRight> ; rdfs:range <http://www.w3.org/2001/XMLSchema#date> ; rdfs:label "终止日"@zh .
<urn:ecp:a01:ubo:v1:Rel_VotingRight_effective_end_bounds> a owl:DatatypeProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_VotingRight> ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ; rdfs:label "终止时间已知区间"@zh .

<urn:ecp:a01:ubo:v1:Rel_RightsControlArrangement> a owl:Class ; rdfs:label "权利或控制安排"@zh ; rdfs:comment "代持、表决委托、一致行动或控制协议等可能改变表面权利归属或最终决定能力的业务安排。"@zh .
<urn:ecp:a01:ubo:v1:Rel_RightsControlArrangement_actor> a owl:ObjectProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_RightsControlArrangement> ; rdfs:range <urn:ecp:a01:ubo:v1:NaturalPerson> ; rdfs:label "实际权利或控制自然人"@zh .
<urn:ecp:a01:ubo:v1:Rel_RightsControlArrangement_subject> a owl:ObjectProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_RightsControlArrangement> ; rdfs:range <urn:ecp:a01:ubo:v1:Organization> ; rdfs:label "受影响组织"@zh .
<urn:ecp:a01:ubo:v1:Rel_RightsControlArrangement_nominal_person> a owl:ObjectProperty ; rdfs:domain <urn:ecp:a01:ubo:v1:Rel_RightsControlArrangement> ; rdfs:range <urn:ecp:a01:ubo:v1:NaturalPerson> ; rdfs:label "名义自然人"@zh .

{
  "apiVersion": "enterprise-risk/feature-definition/v2",
  "kind": "FeatureDefinition",
  "metadata": {
    "id": "a01_rights_time_evidence_gap",
    "version": "1.0.0",
    "name": "股东来源记录的权利时间证据缺口"
  },
  "coverage": [
    {
      "sourceId": "ubo_mvp_standardized",
      "granularity": "DAY",
      "requiredThrough": "evaluationDate",
      "lookbackPeriods": 1
    }
  ],
  "spec": {
    "kind": "typedPlan",
    "operators": [
      {
        "id": "scan_shareholder_source_record",
        "op": "ScanClass",
        "class": "urn:hovo:ecp:a01-ubo:ontology:ShareholderSourceRecord",
        "bind": "sourceObservation"
      },
      {
        "id": "project_rights_time_gap",
        "op": "ProjectAssertions",
        "input": "scan_shareholder_source_record",
        "subject": {
          "template": "urn:hovo:ecp:a01-ubo:derived:rights-time-gap:{sourceObservationId}",
          "fields": {
            "sourceObservationId": {
              "op": "CompactId",
              "value": { "op": "Var", "name": "sourceObservation" }
            }
          }
        },
        "assertions": [
          {
            "predicate": "urn:hovo:ecp:a01-ubo:ontology:rightsTimeGapReason",
            "object": { "op": "String", "value": "SOURCE_SHAREHOLDER_HAS_NO_RIGHTS_EFFECTIVE_DATE_EVIDENCE" },
            "objectKind": "string",
            "cardinality": "one"
          },
          {
            "predicate": "urn:hovo:ecp:a01-ubo:ontology:timeGapForSourceObservation",
            "object": { "op": "Var", "name": "sourceObservation" },
            "objectKind": "iri",
            "cardinality": "one"
          }
        ]
      }
    ]
  },
  "tests": { "contract": "a01-rights-time-evidence-gap-contract-v1" }
}

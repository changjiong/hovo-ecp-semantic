  "issues": [
    {
      "id": "GAP.A01.StateControlScope",
      "kind": "MODEL_GAP",
      "statement": "国资交易监管中的“国有实际控制企业”不能自动等同备案/金融机构规则的国有独资或控股公司；国有相对控股边界仍需权威口径和个案控制证据。",
      "affects": [
        "UBO.Decision.StateOwnership",
        "UBO.Decision.SOEPath",
        "RULE.A01.KF.SOE"
      ],
      "owner": "国资制度专家与客户",
      "recommendation": "取得适用于备案/金融机构识别的官方产权、章程、协议控制资料，必要时取得权威解释。",
      "until_resolved": "国资性质无法确认时特殊法定代表人路径保持 UNKNOWN，不自动套用。",
      "status": "OPEN",
      "severity": "HIGH"
    },
    {
      "id": "GAP.A01.TrustSimplifiedPersonSemantics",
      "kind": "MODEL_GAP",
      "statement": "固定领域知识明确部分其他资产服务信托在结构简单且低风险时“可以简化”，但没有给出统一的简化后替代自然人人选。",
      "affects": [
        "UBO.Decision.TrustServiceRoute",
        "RULE.A01.KF.TRUST_PRODUCTS"
      ],
      "owner": "领域知识责任人与信托业务专家",
      "recommendation": "补充权威条款或经确认业务口径，明确该简化路径实际需要识别/认定的自然人范围。",
      "until_resolved": "只输出简化资格，不从该资格直接生成具体受益所有人人选。",
      "status": "OPEN",
      "severity": "HIGH"
    },
    {
      "id": "GAP.A01.OtherProductSimplifiedPersonSemantics",
      "kind": "MODEL_GAP",
      "statement": "固定领域知识说明企业/职业年金等其他低风险产品“可简化”，但没有给出所有此类产品统一的简化后自然人人选。",
      "affects": [
        "UBO.Decision.OtherProductSimplification",
        "RULE.A01.KF.ASSET_PRODUCTS"
      ],
      "owner": "领域知识责任人与资管产品业务专家",
      "recommendation": "补充对应产品类别的权威简化人选规则；若各类别不同，应分别形成业务判断。",
      "until_resolved": "只输出简化资格，不能由系统擅自套用产品管理人或其他固定自然人。",
      "status": "OPEN",
      "severity": "HIGH"
    }
  ],

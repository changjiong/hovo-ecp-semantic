{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hovo.local/semantic-engineering/1/ecp-semantic-authoring/output.schema.json",
  "allOf": [{"$ref": "../common.schema.json#/$defs/Output"}], "unevaluatedProperties": false,
  "properties": {
    "stage": {"const": "ecp-semantic-authoring"},
    "content": {
      "type": "object", "additionalProperties": false,
      "required": ["domain_model", "profile", "assets", "implementation_map", "required_facts", "case_bindings"],
      "properties": {
        "domain_model": {"$ref": "../common.schema.json#/$defs/ArtifactRef"}, "profile": {"$ref": "../common.schema.json#/$defs/ArtifactRef"},
        "assets": {"type": "array", "items": {"$ref": "#/$defs/Asset"}},
        "implementation_map": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Implementation"}},
        "required_facts": {"type": "array", "items": {"$ref": "#/$defs/Fact"}},
        "case_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/CaseBinding"}}
      }
    }
  },
  "$defs": {
    "Asset": {
      "type": "object", "additionalProperties": false, "required": ["artifact", "kind", "disposition", "dependency_ids"],
      "properties": {
        "artifact": {"$ref": "../common.schema.json#/$defs/ArtifactRef"},
        "kind": {"enum": ["ONTOLOGY", "SHACL", "DERIVATION", "EVALUATION", "ACTION_POLICY"]},
        "disposition": {"enum": ["CANDIDATE", "DRAFT_ONLY"]},
        "dependency_ids": {"$ref": "../common.schema.json#/$defs/Ids"},
        "shacl_stage": {"enum": ["asserted", "domain", "feature", "change", "output", "provenance"]},
        "compiler_evidence_ids": {"$ref": "../common.schema.json#/$defs/Ids"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "SHACL"}}}, "then": {"required": ["shacl_stage"]}},
        {"if": {"properties": {"kind": {"const": "EVALUATION"}, "disposition": {"const": "CANDIDATE"}}}, "then": {"required": ["compiler_evidence_ids"], "properties": {"compiler_evidence_ids": {"minItems": 1}}}}
      ]
    },
    "Implementation": {
      "type": "object", "additionalProperties": false, "required": ["model_id", "representation", "asset_ids", "iri_or_locator", "semantic_preservation", "gap_ids"],
      "properties": {
        "model_id": {"$ref": "../common.schema.json#/$defs/Id"},
        "representation": {"enum": ["DIRECT", "SHACL", "DERIVATION", "EVALUATION", "ACTION_POLICY", "EXTERNAL", "UNSUPPORTED"]},
        "asset_ids": {"$ref": "../common.schema.json#/$defs/Ids"}, "iri_or_locator": {"type": "array", "items": {"$ref": "../common.schema.json#/$defs/Text"}},
        "semantic_preservation": {"$ref": "../common.schema.json#/$defs/Text"}, "gap_ids": {"$ref": "../common.schema.json#/$defs/Ids"}
      },
      "allOf": [{"if": {"properties": {"representation": {"enum": ["EXTERNAL", "UNSUPPORTED"]}}}, "then": {"properties": {"gap_ids": {"minItems": 1}}}, "else": {"properties": {"asset_ids": {"minItems": 1}, "iri_or_locator": {"minItems": 1}}}}]
    },
    "Fact": {
      "type": "object", "additionalProperties": false, "required": ["id", "model_id", "predicate_iri", "consumer_ids", "value_contract", "missing_policy"],
      "properties": {
        "id": {"$ref": "../common.schema.json#/$defs/Id"}, "model_id": {"$ref": "../common.schema.json#/$defs/Id"},
        "predicate_iri": {"$ref": "../common.schema.json#/$defs/Text"}, "consumer_ids": {"$ref": "../common.schema.json#/$defs/Ids", "minItems": 1},
        "value_contract": {"$ref": "../common.schema.json#/$defs/Text"}, "missing_policy": {"$ref": "../common.schema.json#/$defs/Text"}
      }
    },
    "CaseBinding": {
      "type": "object", "additionalProperties": false, "required": ["case_id", "asset_ids", "expected", "forbidden", "gap_ids"],
      "properties": {
        "case_id": {"$ref": "../common.schema.json#/$defs/Id"}, "asset_ids": {"$ref": "../common.schema.json#/$defs/Ids"},
        "expected": {"$ref": "../common.schema.json#/$defs/Text"}, "forbidden": {"$ref": "../common.schema.json#/$defs/Text"}, "gap_ids": {"$ref": "../common.schema.json#/$defs/Ids"}
      }
    }
  }
}

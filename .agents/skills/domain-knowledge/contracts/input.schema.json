{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hovo.local/semantic-engineering/4/domain-knowledge/input.schema.json",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/Input"
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "PRODUCE"
          }
        }
      },
      "then": {
        "required": [
          "business_goal",
          "consumers",
          "sources",
          "source_units",
          "source_extractions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "REVIEW"
          }
        }
      },
      "then": {
        "required": [
          "subjects"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "REVISE"
          }
        }
      },
      "then": {
        "required": [
          "subjects",
          "change_request",
          "sources",
          "source_units",
          "source_extractions"
        ]
      }
    }
  ],
  "unevaluatedProperties": false,
  "properties": {
    "business_goal": {
      "$ref": "../common.schema.json#/$defs/Text"
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../common.schema.json#/$defs/Text"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../common.schema.json#/$defs/SourceRef"
      }
    },
    "source_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "structured-document.schema.json#/$defs/SourceUnit"
      }
    },
    "source_extractions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "structured-document.schema.json#/$defs/SourceExtraction"
      }
    },
    "subjects": {
      "$ref": "../common.schema.json#/$defs/Refs",
      "minItems": 1
    },
    "change_request": {
      "$ref": "../common.schema.json#/$defs/Text"
    }
  },
  "description": "domain-knowledge 内部规范化输入。由 document-intake 将用户原始文档请求解析并 normalize 后形成；Knowledge Formation 从该合同开始。",
  "title": "domain-knowledge Normalized Internal Input 4.0.0"
}

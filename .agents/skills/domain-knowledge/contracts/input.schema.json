{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hovo.local/semantic-engineering/4/domain-knowledge/input.schema.json",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/Input"
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "PRODUCE"
          }
        }
      },
      "then": {
        "required": [
          "business_goal",
          "consumers",
          "sources",
          "source_units",
          "source_extractions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "REVIEW"
          }
        }
      },
      "then": {
        "required": [
          "subjects"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "REVISE"
          }
        }
      },
      "then": {
        "required": [
          "subjects",
          "change_request",
          "sources",
          "source_units",
          "source_extractions"
        ]
      }
    }
  ],
  "unevaluatedProperties": false,
  "properties": {
    "business_goal": {
      "$ref": "../common.schema.json#/$defs/Text"
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../common.schema.json#/$defs/Text"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../common.schema.json#/$defs/SourceRef"
      }
    },
    "source_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://hovo.local/contracts/document-structure/1.0.0/structured-document.schema.json#/$defs/SourceUnit"
      }
    },
    "source_extractions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://hovo.local/contracts/document-structure/1.0.0/structured-document.schema.json#/$defs/SourceExtraction"
      }
    },
    "subjects": {
      "$ref": "../common.schema.json#/$defs/Refs",
      "minItems": 1
    },
    "change_request": {
      "$ref": "../common.schema.json#/$defs/Text"
    }
  },
  "description": "domain-knowledge 请求合同。PRODUCE/REVISE 从上游已结构化、可追溯的文档单元开始，不执行原始 PDF/DOCX/OCR 解析。"
}

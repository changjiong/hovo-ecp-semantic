{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hovo.local/domain-model/business/1/model.schema.json",
  "title": "Business Domain Model 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_version",
    "artifact_id",
    "content_version",
    "name",
    "domain_name",
    "domain_purpose",
    "knowledge_ref",
    "knowledge_basis",
    "scope_mode",
    "question_scope_ids",
    "business_objects",
    "business_relations",
    "business_decisions",
    "external_contexts"
  ],
  "properties": {
    "model_version": {
      "const": "1.0.0"
    },
    "artifact_id": {
      "$ref": "https://hovo.local/domain-model/5/common.schema.json#/$defs/Id"
    },
    "content_version": {
      "$ref": "https://hovo.local/domain-model/5/common.schema.json#/$defs/Text"
    },
    "name": {
      "$ref": "https://hovo.local/domain-model/5/common.schema.json#/$defs/Text"
    },
    "domain_name": {
      "$ref": "https://hovo.local/domain-model/5/common.schema.json#/$defs/Text"
    },
    "domain_purpose": {
      "$ref": "https://hovo.local/domain-model/5/common.schema.json#/$defs/Text"
    },
    "knowledge_ref": {
      "$ref": "https://hovo.local/domain-model/5/common.schema.json#/$defs/ArtifactRef",
      "properties": {
        "contract_version": {
          "const": "5.0.0"
        }
      }
    },
    "knowledge_basis": {
      "enum": [
        "DRAFT",
        "CONFIRMED"
      ]
    },
    "scope_mode": {
      "enum": [
        "FULL_BASELINE",
        "EXPLICIT_SUBSET"
      ]
    },
    "question_scope_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://hovo.local/domain-model/5/common.schema.json#/$defs/Id"
      }
    },
    "business_objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/BusinessObject"
      }
    },
    "business_relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BusinessRelation"
      }
    },
    "business_decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BusinessDecision"
      }
    },
    "external_contexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExternalContext"
      }
    }
  },
  "$defs": {
    "Id": {
      "$ref": "https://hovo.local/domain-model/5/common.schema.json#/$defs/Id"
    },
    "Text": {
      "$ref": "https://hovo.local/domain-model/5/common.schema.json#/$defs/Text"
    },
    "Ids": {
      "$ref": "https://hovo.local/domain-model/5/common.schema.json#/$defs/Ids"
    },
    "Cardinality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "ScalarAttribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "label",
        "type",
        "cardinality",
        "meaning"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "type": {
          "enum": [
            "Text",
            "Boolean",
            "Integer",
            "Decimal",
            "Date",
            "DateTime",
            "Enum",
            "IntervalSet"
          ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Text"
          }
        },
        "cardinality": {
          "$ref": "#/$defs/Cardinality"
        },
        "meaning": {
          "$ref": "#/$defs/Text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "Enum"
              }
            }
          },
          "then": {
            "required": [
              "values"
            ]
          },
          "else": {
            "not": {
              "required": [
                "values"
              ]
            }
          }
        }
      ]
    },
    "BusinessObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "definition",
        "identity_description",
        "identity_attributes",
        "attributes",
        "examples",
        "counterexamples"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "$ref": "#/$defs/Text"
        },
        "category": {
          "enum": [
            "PARTICIPANT",
            "BUSINESS_OBJECT",
            "EVIDENCE",
            "RESULT"
          ]
        },
        "definition": {
          "$ref": "#/$defs/Text"
        },
        "identity_description": {
          "$ref": "#/$defs/Text"
        },
        "identity_attributes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "attributes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ScalarAttribute"
          }
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Text"
          }
        },
        "counterexamples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Text"
          }
        }
      }
    },
    "Participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "label",
        "object_id",
        "cardinality",
        "meaning"
      ],
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "object_id": {
          "$ref": "#/$defs/Id"
        },
        "cardinality": {
          "$ref": "#/$defs/Cardinality"
        },
        "meaning": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "BusinessRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "definition",
        "participants",
        "attributes",
        "temporal_semantics",
        "evidence_semantics",
        "examples",
        "counterexamples"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "$ref": "#/$defs/Text"
        },
        "definition": {
          "$ref": "#/$defs/Text"
        },
        "participants": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/Participant"
          }
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScalarAttribute"
          }
        },
        "temporal_semantics": {
          "$ref": "#/$defs/Text"
        },
        "evidence_semantics": {
          "$ref": "#/$defs/Text"
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Text"
          }
        },
        "counterexamples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Text"
          }
        }
      }
    },
    "DecisionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "meaning"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/Text"
        },
        "meaning": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "DecisionOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "label",
        "meaning"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/Text"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "meaning": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "BusinessDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "business_question",
        "definition",
        "decision_mode",
        "inputs",
        "outcomes",
        "criteria",
        "non_sufficient_facts",
        "unknown_behavior",
        "evidence_requirements",
        "human_boundary",
        "external_context_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "$ref": "#/$defs/Text"
        },
        "business_question": {
          "$ref": "#/$defs/Text"
        },
        "definition": {
          "$ref": "#/$defs/Text"
        },
        "decision_mode": {
          "enum": [
            "DETERMINISTIC",
            "PROFESSIONAL_JUDGMENT",
            "MIXED"
          ]
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/DecisionInput"
          }
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/DecisionOutcome"
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Text"
          }
        },
        "non_sufficient_facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          }
        },
        "unknown_behavior": {
          "$ref": "#/$defs/Text"
        },
        "evidence_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          }
        },
        "human_boundary": {
          "$ref": "#/$defs/Text"
        },
        "external_context_ids": {
          "$ref": "#/$defs/Ids"
        }
      }
    },
    "ContextInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "meaning"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/Text"
        },
        "meaning": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "ExternalContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "source_domain",
        "meaning",
        "required_inputs",
        "used_by_decision_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "$ref": "#/$defs/Text"
        },
        "source_domain": {
          "$ref": "#/$defs/Text"
        },
        "meaning": {
          "$ref": "#/$defs/Text"
        },
        "required_inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextInput"
          }
        },
        "used_by_decision_ids": {
          "$ref": "#/$defs/Ids"
        }
      }
    }
  }
}

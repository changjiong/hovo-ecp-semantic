{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hovo.local/domain-model/business/1/coverage.schema.json",
  "title": "Domain Model Coverage 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "coverage_version",
    "artifact_id",
    "content_version",
    "model_ref",
    "knowledge_ref",
    "knowledge_basis",
    "scope_mode",
    "question_scope_ids",
    "rule_coverage",
    "question_coverage",
    "case_coverage",
    "upstream_issue_bindings",
    "model_issues"
  ],
  "properties": {
    "coverage_version": {
      "const": "1.0.0"
    },
    "artifact_id": {
      "$ref": "https://hovo.local/domain-model/5/common.schema.json#/$defs/Id"
    },
    "content_version": {
      "$ref": "https://hovo.local/domain-model/5/common.schema.json#/$defs/Text"
    },
    "model_ref": {
      "$ref": "https://hovo.local/domain-model/5/common.schema.json#/$defs/ArtifactRef",
      "properties": {
        "contract_version": {
          "const": "business-domain-model/1.0.0"
        }
      }
    },
    "knowledge_ref": {
      "$ref": "https://hovo.local/domain-model/5/common.schema.json#/$defs/ArtifactRef",
      "properties": {
        "contract_version": {
          "const": "5.0.0"
        }
      }
    },
    "scope_mode": {
      "enum": [
        "FULL_BASELINE",
        "EXPLICIT_SUBSET"
      ]
    },
    "question_scope_ids": {
      "$ref": "https://hovo.local/domain-model/5/common.schema.json#/$defs/Ids",
      "minItems": 1
    },
    "rule_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/RuleCoverage"
      }
    },
    "question_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/QuestionCoverage"
      }
    },
    "case_coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CaseCoverage"
      }
    },
    "upstream_issue_bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/IssueBinding"
      }
    },
    "model_issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ModelIssue"
      }
    },
    "knowledge_basis": {
      "enum": [
        "DRAFT",
        "CONFIRMED"
      ]
    }
  },
  "$defs": {
    "Id": {
      "$ref": "https://hovo.local/domain-model/5/common.schema.json#/$defs/Id"
    },
    "Text": {
      "$ref": "https://hovo.local/domain-model/5/common.schema.json#/$defs/Text"
    },
    "Ids": {
      "$ref": "https://hovo.local/domain-model/5/common.schema.json#/$defs/Ids"
    },
    "Facet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_text",
        "model_refs",
        "handling",
        "explanation"
      ],
      "properties": {
        "source_text": {
          "$ref": "#/$defs/Text"
        },
        "model_refs": {
          "$ref": "#/$defs/Ids"
        },
        "handling": {
          "enum": [
            "MODELED",
            "EXTERNAL_CONTEXT",
            "NO_MODEL_CHANGE",
            "GAP"
          ]
        },
        "explanation": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "RuleCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge_rule_id",
        "question_ids",
        "modeling_classification",
        "reason",
        "model_refs",
        "status",
        "gap_ids",
        "facets"
      ],
      "properties": {
        "knowledge_rule_id": {
          "$ref": "#/$defs/Id"
        },
        "question_ids": {
          "$ref": "#/$defs/Ids"
        },
        "modeling_classification": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "CORE_STRUCTURE",
              "DOMAIN_DECISION",
              "EXTERNAL_CONTEXT",
              "NO_MODEL_CHANGE"
            ]
          }
        },
        "reason": {
          "$ref": "#/$defs/Text"
        },
        "model_refs": {
          "$ref": "#/$defs/Ids"
        },
        "status": {
          "enum": [
            "MODELED",
            "PARTIAL",
            "DEFERRED",
            "EXTERNAL_CONTEXT",
            "NO_MODEL_CHANGE"
          ]
        },
        "gap_ids": {
          "$ref": "#/$defs/Ids"
        },
        "facets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "preconditions",
            "conditions",
            "result",
            "exceptions",
            "missing_evidence",
            "effective_period"
          ],
          "properties": {
            "scope": {
              "$ref": "#/$defs/Facet"
            },
            "preconditions": {
              "$ref": "#/$defs/Facet"
            },
            "conditions": {
              "$ref": "#/$defs/Facet"
            },
            "result": {
              "$ref": "#/$defs/Facet"
            },
            "exceptions": {
              "$ref": "#/$defs/Facet"
            },
            "missing_evidence": {
              "$ref": "#/$defs/Facet"
            },
            "effective_period": {
              "$ref": "#/$defs/Facet"
            }
          }
        }
      }
    },
    "QuestionCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "question",
        "status",
        "model_refs",
        "gap_ids",
        "rule_ids",
        "case_ids",
        "answer",
        "reason"
      ],
      "properties": {
        "question_id": {
          "$ref": "#/$defs/Id"
        },
        "question": {
          "$ref": "#/$defs/Text"
        },
        "status": {
          "enum": [
            "MODELED",
            "PARTIAL",
            "DEFERRED",
            "EXTERNAL_CONTEXT",
            "NO_MODEL_CHANGE"
          ]
        },
        "model_refs": {
          "$ref": "#/$defs/Ids"
        },
        "gap_ids": {
          "$ref": "#/$defs/Ids"
        },
        "rule_ids": {
          "$ref": "#/$defs/Ids"
        },
        "case_ids": {
          "$ref": "#/$defs/Ids"
        },
        "answer": {
          "$ref": "#/$defs/Text"
        },
        "reason": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "CaseCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "status",
        "model_refs",
        "expected",
        "forbidden",
        "explanation"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/Id"
        },
        "status": {
          "enum": [
            "EXPLAINED",
            "CONTEXT_ONLY",
            "BLOCKED"
          ]
        },
        "model_refs": {
          "$ref": "#/$defs/Ids"
        },
        "expected": {
          "$ref": "#/$defs/Text"
        },
        "forbidden": {
          "$ref": "#/$defs/Text"
        },
        "explanation": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "IssueBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge_issue_id",
        "handling",
        "model_issue_ids",
        "reason"
      ],
      "properties": {
        "knowledge_issue_id": {
          "$ref": "#/$defs/Id"
        },
        "handling": {
          "enum": [
            "CORE_MODEL_GAP",
            "EXTERNAL_CONTEXT_OPEN",
            "NO_MODEL_IMPACT"
          ]
        },
        "model_issue_ids": {
          "$ref": "#/$defs/Ids"
        },
        "reason": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "ModelIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "affects",
        "owner",
        "recommendation",
        "until_resolved",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "statement": {
          "$ref": "#/$defs/Text"
        },
        "affects": {
          "$ref": "#/$defs/Ids",
          "minItems": 1
        },
        "owner": {
          "$ref": "#/$defs/Text"
        },
        "recommendation": {
          "$ref": "#/$defs/Text"
        },
        "until_resolved": {
          "$ref": "#/$defs/Text"
        },
        "status": {
          "const": "OPEN"
        },
        "severity": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        }
      }
    }
  }
}

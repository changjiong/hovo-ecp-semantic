  "intent": {
    "job_to_be_done": "从固定领域知识形成业务人员可直接理解的业务对象、业务关系、领域判断与最小外部上下文",
    "target_users": [
      "业务领域专家",
      "领域建模者",
      "后续语义编制者"
    ],
    "inputs": [
      "固定版本领域知识基线（Term、Rule、Question、Case、OPEN）",
      "默认 FULL_BASELINE 范围；显式子集须有用户/调用方明确范围请求",
      "旧模型仅用于 REVIEW/REVISE，不进入 PRODUCE"
    ],
    "outputs": [
      "model.yaml（纯业务领域模型）",
      "coverage.json（知识覆盖与审计）",
      "review.md（业务审阅视图）",
      "coverage.md（覆盖审计视图）",
      "output.json（交接索引）"
    ],
    "exclusions": [
      "技术 DSL 与表达式树",
      "数据库模型与数据映射",
      "生产工作流与状态机",
      "机构审批流程",
      "ECP平台执行资产",
      "把外部上下文扩张成邻接领域模型",
      "为了减少对象数量而制造业务无效组合"
    ]
  },
  "lifecycle_stage": "candidate"
}

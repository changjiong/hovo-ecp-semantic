{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "profile",
    "migrations",
    "definitions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "ECP_V3_LIFECYCLE_BINDING"
    },
    "profile": {
      "enum": [
        "NONE",
        "OCCURRENCE_REVISION_V1"
      ]
    },
    "migrations": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "manifestDigest",
          "source",
          "target"
        ],
        "properties": {
          "manifestDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "definitionId",
              "identityRevision",
              "key"
            ],
            "properties": {
              "definitionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 191,
                "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
              },
              "identityRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "key": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "value"
                      ],
                      "properties": {
                        "kind": {
                          "const": "IRI"
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 65536
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "scope",
                        "label"
                      ],
                      "properties": {
                        "kind": {
                          "const": "BLANK"
                        },
                        "scope": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 65536
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 65536
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "lexical",
                        "datatype",
                        "language"
                      ],
                      "properties": {
                        "kind": {
                          "const": "LITERAL"
                        },
                        "lexical": {
                          "type": "string",
                          "maxLength": 65536
                        },
                        "datatype": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 65536
                        },
                        "language": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "definitionId",
              "identityRevision",
              "key"
            ],
            "properties": {
              "definitionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 191,
                "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
              },
              "identityRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "key": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "value"
                      ],
                      "properties": {
                        "kind": {
                          "const": "IRI"
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 65536
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "scope",
                        "label"
                      ],
                      "properties": {
                        "kind": {
                          "const": "BLANK"
                        },
                        "scope": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 65536
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 65536
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "lexical",
                        "datatype",
                        "language"
                      ],
                      "properties": {
                        "kind": {
                          "const": "LITERAL"
                        },
                        "lexical": {
                          "type": "string",
                          "maxLength": 65536
                        },
                        "datatype": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 65536
                        },
                        "language": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "definitions": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "definitionId",
          "identityRevision",
          "definitionStatus",
          "evaluation",
          "resolveWhenFalse",
          "retirementReason"
        ],
        "properties": {
          "definitionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "identityRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "definitionStatus": {
            "enum": [
              "ACTIVE",
              "RETIRED"
            ]
          },
          "evaluation": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "moduleId",
                  "stageId"
                ],
                "properties": {
                  "moduleId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 191,
                    "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
                  },
                  "stageId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 191,
                    "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
                  }
                }
              }
            ]
          },
          "resolveWhenFalse": {
            "type": "boolean"
          },
          "retirementReason": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            ]
          }
        }
      }
    }
  }
}

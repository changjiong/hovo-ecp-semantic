{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ecp:v3:mapping-definition:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "mappingId",
    "version",
    "ontologySourceDigest",
    "dataSources",
    "scans",
    "projections"
  ],
  "$defs": {
    "v3Expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "column"
          ],
          "properties": {
            "kind": {
              "enum": [
                "COLUMN",
                "BOUND"
              ]
            },
            "column": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "term"
          ],
          "properties": {
            "kind": {
              "const": "CONSTANT"
            },
            "term": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "value"
                  ],
                  "properties": {
                    "kind": {
                      "const": "IRI"
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "scope",
                    "label"
                  ],
                  "properties": {
                    "kind": {
                      "const": "BLANK"
                    },
                    "scope": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "lexical",
                    "datatype",
                    "language"
                  ],
                  "properties": {
                    "kind": {
                      "const": "LITERAL"
                    },
                    "lexical": {
                      "type": "string",
                      "maxLength": 1048576
                    },
                    "datatype": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
                    },
                    "language": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "operator",
            "left",
            "right"
          ],
          "properties": {
            "kind": {
              "const": "COMPARE"
            },
            "operator": {
              "enum": [
                "EQ",
                "NE",
                "LT",
                "LTE",
                "GT",
                "GTE"
              ]
            },
            "left": {
              "$ref": "#/$defs/v3Expression"
            },
            "right": {
              "$ref": "#/$defs/v3Expression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "left",
            "right"
          ],
          "properties": {
            "kind": {
              "enum": [
                "CONTAINS",
                "STARTS_WITH",
                "ADD",
                "SUBTRACT",
                "MULTIPLY",
                "DATE_SUBTRACT"
              ]
            },
            "left": {
              "$ref": "#/$defs/v3Expression"
            },
            "right": {
              "$ref": "#/$defs/v3Expression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "left",
            "right",
            "scale",
            "rounding"
          ],
          "properties": {
            "kind": {
              "const": "DIVIDE"
            },
            "left": {
              "$ref": "#/$defs/v3Expression"
            },
            "right": {
              "$ref": "#/$defs/v3Expression"
            },
            "scale": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "rounding": {
              "enum": [
                "HALF_EVEN",
                "HALF_UP",
                "TOWARD_ZERO",
                "AWAY_FROM_ZERO",
                "FLOOR",
                "CEILING",
                "EXACT"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "inputs"
          ],
          "properties": {
            "kind": {
              "enum": [
                "AND",
                "OR",
                "COALESCE"
              ]
            },
            "inputs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/v3Expression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "prefix",
            "inputs"
          ],
          "properties": {
            "kind": {
              "const": "CONTENT_ID"
            },
            "prefix": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4025
            },
            "inputs": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/v3Expression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "input"
          ],
          "properties": {
            "kind": {
              "const": "NOT"
            },
            "input": {
              "$ref": "#/$defs/v3Expression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "input",
            "datatype"
          ],
          "properties": {
            "kind": {
              "const": "CAST"
            },
            "input": {
              "$ref": "#/$defs/v3Expression"
            },
            "datatype": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "input",
            "characters",
            "position"
          ],
          "properties": {
            "kind": {
              "const": "STRING_STRIP"
            },
            "input": {
              "$ref": "#/$defs/v3Expression"
            },
            "characters": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "position": {
              "enum": [
                "ALL",
                "ENDS"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "condition",
            "thenValue",
            "elseValue"
          ],
          "properties": {
            "kind": {
              "const": "IF"
            },
            "condition": {
              "$ref": "#/$defs/v3Expression"
            },
            "thenValue": {
              "$ref": "#/$defs/v3Expression"
            },
            "elseValue": {
              "$ref": "#/$defs/v3Expression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value",
            "duration"
          ],
          "properties": {
            "kind": {
              "const": "DATE_ADD"
            },
            "value": {
              "$ref": "#/$defs/v3Expression"
            },
            "duration": {
              "$ref": "#/$defs/v3Expression"
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "ECP_V3_MAPPING"
    },
    "mappingId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ontologySourceDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "dataSources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "dataSourceCode",
          "environment"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "dataSourceCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "environment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "scans": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dataSourceRef",
          "schema",
          "table",
          "relationKind",
          "columns",
          "recordKey"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "dataSourceRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "table": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "relationKind": {
            "enum": [
              "TABLE",
              "VIEW"
            ]
          },
          "recordKey": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "datatype"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "datatype": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
                  "maxLength": 4096
                }
              }
            }
          }
        }
      }
    },
    "projections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tableRef",
          "subject",
          "classes",
          "properties",
          "relationships",
          "graph"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "tableRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "subject": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prefix",
              "columns"
            ],
            "properties": {
              "prefix": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
                "maxLength": 4096
              },
              "columns": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "uniqueItems": false,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "separators": {
                "type": "array",
                "maxItems": 255,
                "items": {
                  "type": "string",
                  "maxLength": 4096
                }
              },
              "suffix": {
                "type": "string",
                "maxLength": 4096
              }
            }
          },
          "classes": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
              "maxLength": 4096
            }
          },
          "properties": {
            "type": "array",
            "maxItems": 512,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "predicate",
                "column",
                "nullPolicy"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "predicate": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
                  "maxLength": 4096
                },
                "column": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "nullPolicy": {
                  "enum": [
                    "OMIT",
                    "REJECT"
                  ]
                },
                "cardinality": {
                  "enum": [
                    "ONE",
                    "MANY"
                  ]
                }
              }
            }
          },
          "relationships": {
            "type": "array",
            "maxItems": 512,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "predicate",
                "target",
                "nullPolicy"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "predicate": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
                  "maxLength": 4096
                },
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "prefix",
                    "columns"
                  ],
                  "properties": {
                    "prefix": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
                      "maxLength": 4096
                    },
                    "columns": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 256,
                      "uniqueItems": false,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    },
                    "separators": {
                      "type": "array",
                      "maxItems": 255,
                      "items": {
                        "type": "string",
                        "maxLength": 4096
                      }
                    },
                    "suffix": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  }
                },
                "nullPolicy": {
                  "enum": [
                    "OMIT",
                    "REJECT"
                  ]
                }
              }
            }
          },
          "graph": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "requirements"
      ],
      "properties": {
        "mode": {
          "const": "FULL_SNAPSHOT"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "projectionId",
              "requiredScans",
              "onSourceUnavailable",
              "onPartialRead",
              "onRejectedRow"
            ],
            "properties": {
              "projectionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "requiredScans": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "onSourceUnavailable": {
                "const": "UNKNOWN"
              },
              "onPartialRead": {
                "const": "UNKNOWN"
              },
              "onRejectedRow": {
                "const": "UNKNOWN"
              }
            }
          }
        }
      }
    },
    "joins": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "leftScan",
          "rightScan",
          "kind",
          "cardinality",
          "keyEquality",
          "nullPolicy",
          "keys",
          "columns"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "leftScan": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "rightScan": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "INNER",
              "LEFT"
            ]
          },
          "cardinality": {
            "enum": [
              "MANY_TO_ONE",
              "MANY_TO_MANY"
            ]
          },
          "keyEquality": {
            "const": "RDF_TERM"
          },
          "nullPolicy": {
            "const": "NO_MATCH"
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "left",
                "right"
              ],
              "properties": {
                "left": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "right": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "output",
                "side",
                "column"
              ],
              "properties": {
                "output": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "side": {
                  "enum": [
                    "LEFT",
                    "RIGHT"
                  ]
                },
                "column": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        }
      }
    },
    "filters": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target",
          "columns",
          "condition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "SCAN",
                  "PROJECTION"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "columns": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "condition": {
            "$ref": "#/$defs/v3Expression"
          }
        }
      }
    }
  }
}

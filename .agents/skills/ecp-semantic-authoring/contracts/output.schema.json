{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hovo.local/semantic-engineering/2/ecp-semantic-authoring/output.schema.json",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/Output"
    }
  ],
  "unevaluatedProperties": false,
  "properties": {
    "stage": {
      "const": "ecp-semantic-authoring"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_model",
        "business_model",
        "profile",
        "deployment_boundary",
        "schema_snapshot",
        "assets",
        "implementation_map",
        "fact_bindings",
        "case_bindings",
        "candidate_closure"
      ],
      "properties": {
        "domain_model": {
          "$ref": "../common.schema.json#/$defs/ArtifactRef"
        },
        "business_model": {
          "$ref": "../common.schema.json#/$defs/ArtifactRef",
          "properties": {
            "contract_version": {
              "const": "business-domain-model/1.0.0"
            }
          }
        },
        "profile": {
          "$ref": "../common.schema.json#/$defs/ArtifactRef"
        },
        "deployment_boundary": {
          "$ref": "../common.schema.json#/$defs/ArtifactRef"
        },
        "schema_snapshot": {
          "$ref": "../common.schema.json#/$defs/ArtifactRef"
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Asset"
          }
        },
        "implementation_map": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Implementation"
          }
        },
        "fact_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FactBinding"
          }
        },
        "case_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/CaseBinding"
          }
        },
        "candidate_closure": {
          "$ref": "#/$defs/CandidateClosure"
        }
      }
    }
  },
  "$defs": {
    "Asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "kind",
        "dependency_ids"
      ],
      "properties": {
        "artifact": {
          "$ref": "../common.schema.json#/$defs/ArtifactRef"
        },
        "kind": {
          "enum": [
            "ONTOLOGY",
            "SHACL",
            "MAPPING",
            "DERIVATION",
            "EVALUATION",
            "LIFECYCLE",
            "ACTION_POLICY"
          ]
        },
        "dependency_ids": {
          "$ref": "../common.schema.json#/$defs/Ids"
        },
        "shacl_stage": {
          "enum": [
            "asserted",
            "domain",
            "feature",
            "change",
            "output",
            "provenance"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "SHACL"
              }
            }
          },
          "then": {
            "required": [
              "shacl_stage"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "not": {
                  "const": "SHACL"
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "shacl_stage"
              ]
            }
          }
        }
      ]
    },
    "Implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "representations",
        "asset_ids",
        "locators",
        "semantic_preservation",
        "gap_ids"
      ],
      "properties": {
        "model_id": {
          "$ref": "../common.schema.json#/$defs/Id"
        },
        "representations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ONTOLOGY",
              "SHACL",
              "MAPPING",
              "DERIVATION",
              "EVALUATION",
              "LIFECYCLE",
              "ACTION_POLICY",
              "EXTERNAL",
              "UNSUPPORTED"
            ]
          }
        },
        "asset_ids": {
          "$ref": "../common.schema.json#/$defs/Ids"
        },
        "locators": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Text"
          }
        },
        "semantic_preservation": {
          "$ref": "../common.schema.json#/$defs/Text"
        },
        "gap_ids": {
          "$ref": "../common.schema.json#/$defs/Ids"
        }
      }
    },
    "FactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "model_id",
        "predicate_iri",
        "value_contract",
        "missing_policy",
        "status",
        "mapping_asset_id",
        "projection_id",
        "source_columns",
        "basis",
        "gap_ids"
      ],
      "properties": {
        "id": {
          "$ref": "../common.schema.json#/$defs/Id"
        },
        "model_id": {
          "$ref": "../common.schema.json#/$defs/Id"
        },
        "predicate_iri": {
          "$ref": "../common.schema.json#/$defs/Text"
        },
        "value_contract": {
          "$ref": "../common.schema.json#/$defs/Text"
        },
        "missing_policy": {
          "$ref": "../common.schema.json#/$defs/Text"
        },
        "status": {
          "enum": [
            "MAPPED",
            "PARTIAL",
            "UNAVAILABLE"
          ]
        },
        "mapping_asset_id": {
          "$ref": "../common.schema.json#/$defs/Id"
        },
        "projection_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_columns": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Text"
          }
        },
        "basis": {
          "$ref": "../common.schema.json#/$defs/Text"
        },
        "gap_ids": {
          "$ref": "../common.schema.json#/$defs/Ids"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "MAPPED"
              }
            }
          },
          "then": {
            "properties": {
              "projection_id": {
                "type": "string",
                "minLength": 1
              },
              "source_columns": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "PARTIAL",
                  "UNAVAILABLE"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "gap_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "CaseBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "asset_ids",
        "expected",
        "forbidden",
        "gap_ids"
      ],
      "properties": {
        "case_id": {
          "$ref": "../common.schema.json#/$defs/Id"
        },
        "asset_ids": {
          "$ref": "../common.schema.json#/$defs/Ids"
        },
        "expected": {
          "$ref": "../common.schema.json#/$defs/Text"
        },
        "forbidden": {
          "$ref": "../common.schema.json#/$defs/Text"
        },
        "gap_ids": {
          "$ref": "../common.schema.json#/$defs/Ids"
        }
      }
    },
    "CandidateClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "asset_ids",
        "gap_ids",
        "basis"
      ],
      "properties": {
        "status": {
          "enum": [
            "READY",
            "BLOCKED"
          ]
        },
        "asset_ids": {
          "$ref": "../common.schema.json#/$defs/Ids",
          "minItems": 1
        },
        "gap_ids": {
          "$ref": "../common.schema.json#/$defs/Ids"
        },
        "basis": {
          "$ref": "../common.schema.json#/$defs/Text"
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "BLOCKED"
          }
        }
      },
      "then": {
        "properties": {
          "gap_ids": {
            "minItems": 1
          }
        }
      }
    }
  }
}

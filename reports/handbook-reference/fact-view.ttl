<urn:hovo:demo:view:current> a h:FactView ;
    h:businessDate "2026-02-15"^^xsd:date ;
    h:knowledgeCutoff "2026-02-15T00:00:00+00:00"^^xsd:dateTime ;
    h:selectionId "SEL-DEMO-01" .

ex:P1 a h:NaturalPerson,
        h:Subject ;

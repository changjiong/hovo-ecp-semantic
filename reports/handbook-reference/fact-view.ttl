@prefix ex: <urn:hovo:demo:> .
@prefix h: <urn:hovo:semantic:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:hovo:demo:position:E1> a h:OwnershipPosition ;
    h:denominator "TOTAL_OUTSTANDING_EQUITY" ;
    h:holder ex:P1 ;
    h:issuer ex:A ;
    h:right "OWNERSHIP" ;
    h:shareRatio 0.6 ;
    h:share_class "ORDINARY" ;
    h:supportedBy <urn:hovo:demo:assertion:a1> .


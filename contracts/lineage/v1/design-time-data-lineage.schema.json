{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hovo.local/contracts/lineage/design-time-data-lineage/1.0.0/schema.json",
  "title": "Hovo Design-time Data Lineage Contract 1.0.0",
  "description": "描述业务事实和业务身份在设计期如何绑定到 Mapping、Scan/Column 与 Join。它不声称记录某次 Runtime 实际读取的行。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "lineage_id", "content_version", "mapping_refs", "schema_snapshot", "facts", "identities"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "lineage_id": {"$ref": "#/$defs/Id"},
    "content_version": {"$ref": "#/$defs/Text"},
    "mapping_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ArtifactRef"},
      "uniqueItems": true
    },
    "schema_snapshot": {"$ref": "#/$defs/ArtifactRef"},
    "facts": {
      "type": "array",
      "items": {"$ref": "#/$defs/FactLineage"}
    },
    "identities": {
      "type": "array",
      "items": {"$ref": "#/$defs/IdentityLineage"}
    }
  },
  "$defs": {
    "Text": {"type": "string", "minLength": 1},
    "Id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"},
    "Digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "Path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "Ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/Id"},
      "uniqueItems": true
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "content_version", "contract_version", "path", "digest"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/Id"},
        "content_version": {"$ref": "#/$defs/Text"},
        "contract_version": {"$ref": "#/$defs/Text"},
        "path": {"$ref": "#/$defs/Path"},
        "digest": {"$ref": "#/$defs/Digest"}
      }
    },
    "SourceField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "scan_id", "column"],
      "properties": {
        "locator": {"$ref": "#/$defs/Text"},
        "scan_id": {"$ref": "#/$defs/Id"},
        "column": {"$ref": "#/$defs/Text"},
        "data_source_code": {"$ref": "#/$defs/Text"},
        "environment": {"$ref": "#/$defs/Text"}
      }
    },
    "FactLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "binding_id", "predicate_iri", "mapping_artifact_ids", "source_fields", "join_ids", "execution_owner"],
      "properties": {
        "fact_id": {"$ref": "#/$defs/Id"},
        "binding_id": {"$ref": "#/$defs/Id"},
        "predicate_iri": {"$ref": "#/$defs/Text"},
        "mapping_artifact_ids": {"$ref": "#/$defs/Ids", "minItems": 1},
        "source_fields": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/SourceField"}
        },
        "join_ids": {"$ref": "#/$defs/Ids"},
        "execution_owner": {"enum": ["MAPPING", "GOVERNED_SOURCE", "AUTHORING_RULE", "BLOCKED"]},
        "evidence_ids": {"$ref": "#/$defs/Ids"}
      }
    },
    "IdentityLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_rule_id", "entity_iri", "record_key_fields", "mapping_artifact_ids"],
      "properties": {
        "identity_rule_id": {"$ref": "#/$defs/Id"},
        "entity_iri": {"$ref": "#/$defs/Text"},
        "record_key_fields": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/SourceField"}
        },
        "mapping_artifact_ids": {"$ref": "#/$defs/Ids", "minItems": 1},
        "evidence_ids": {"$ref": "#/$defs/Ids"}
      }
    }
  }
}

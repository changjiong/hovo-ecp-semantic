{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-cognitive.dev/contracts/semantic-workspace-package-manifest-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion","kind","bundleFormat","semanticProfileId","semanticProfileDigest","ontology","mapping","ruleSet","schemas"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ECP_SEMANTIC_WORKSPACE_PACKAGE"},
    "bundleFormat": {"const": "enterprise-cognitive/semantic-workspace-package/1.0.0"},
    "semanticProfileId": {"type":"string","pattern":"^(?!\\s*$).+$","maxLength":191},
    "semanticProfileDigest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "ontology": {"type":"object","additionalProperties":false,"properties":{"path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[^\\\\\\u0000]{1,512}$"},"sourceDigest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"mediaType":{"const":"text/turtle"}},"required":["path","sourceDigest","mediaType"]},
    "mapping": {"type":"object","additionalProperties":false,"properties":{"path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[^\\\\\\u0000]{1,512}$"},"sourceDigest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"mediaType":{"const":"application/json"},"ontologySourceDigest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},"required":["path","sourceDigest","mediaType","ontologySourceDigest"]},
    "ruleSet": {"type":"object","additionalProperties":false,"properties":{"manifestPath":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[^\\\\\\u0000]{1,512}$"},"sourceDigest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},"required":["manifestPath","sourceDigest"]},
    "schemas": {"type":"array","maxItems":64,"items":{"type":"object","additionalProperties":false,"properties":{"path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[^\\\\\\u0000]{1,512}$"},"sourceDigest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"dataSourceCode":{"type":"string","pattern":"^(?!\\s*$).+$","maxLength":191},"environment":{"type":"string","pattern":"^(?!\\s*$).+$","maxLength":191}},"required":["path","sourceDigest","dataSourceCode","environment"]}}
  }
}

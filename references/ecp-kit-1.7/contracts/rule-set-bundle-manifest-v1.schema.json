{
  "$id": "urn:ecp:contracts:rule-set-bundle-manifest:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "bundleFormat", "semanticProfileId", "semanticProfileDigest", "members"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ECP_RULE_SET_BUNDLE"},
    "bundleFormat": {"const": "enterprise-cognitive/rule-set-bundle/1.0.0"},
    "semanticProfileId": {"type": "string", "pattern": "^(?!\\s*$).+$", "maxLength": 256},
    "semanticProfileDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "members": {
      "type": "array", "minItems": 1, "maxItems": 96,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["assetSeriesId", "assetType", "name", "description", "path", "mediaType", "sourceDigest", "shaclStage"],
        "properties": {
          "assetSeriesId": {"type": "string", "pattern": "^(?!\\s*$).+$", "maxLength": 191},
          "assetType": {"enum": ["SHACL", "DERIVATION", "EVALUATION", "ACTION_POLICY"]},
          "name": {"type": "string", "pattern": "^(?!\\s*$).+$", "maxLength": 512},
          "description": {"type": "string", "maxLength": 65535},
          "path": {"type": "string", "pattern": "^rules/[A-Za-z0-9][A-Za-z0-9._/-]*\\.(?:ttl|json)$", "maxLength": 512},
          "mediaType": {"enum": ["text/turtle", "application/json"]},
          "sourceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "shaclStage": {"enum": ["asserted", "domain", "feature", "change", "output", "provenance", null]}
        }
      }
    }
  }
}
